<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>AowEmailWrapper</RootNamespace>
    <AssemblyName>AowEmailWrapper</AssemblyName>
    <ApplicationIcon>online48.ico</ApplicationIcon>
    <Version>2.0.8</Version>
    <Product>Age of Wonders Email Wrapper</Product>
    <Copyright>Copyright © 2010-2026 David Honess and contributors</Copyright>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- ImageList streams in the designer .resx files still go through BinaryFormatter on .NET 8 -->
    <GenerateResourceWarnOnBinaryFormatterUse>false</GenerateResourceWarnOnBinaryFormatterUse>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MailKit" Version="4.17.0" />
    <PackageReference Include="Microsoft.Identity.Client" Version="4.88.0" />
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="8.0.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EricDaugherty.CSES\EricDaugherty.CSES.csproj" />
    <ProjectReference Include="..\FlimFlan.IconEncoder\FlimFlan.IconEncoder.csproj" />
    <ProjectReference Include="..\Mozilla.Autoconfig\Mozilla.Autoconfig.csproj" />
    <ProjectReference Include="..\Zlib\zlib.net.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Designer image lists as plain PNGs, loaded by ImageListLoader instead of BinaryFormatter streams -->
    <None Remove="Resources\ImageLists\**\*.png" />
    <EmbeddedResource Include="Resources\ImageLists\**\*.png" WithCulture="false" />
    <None Remove="Resources\Theme\*.png" />
    <EmbeddedResource Include="Resources\Theme\*.png" WithCulture="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- Runtime data files shipped next to the executable -->
    <None Update="Localization.xml" CopyToOutputDirectory="PreserveNewest" />
    <None Update="notify.wav" CopyToOutputDirectory="PreserveNewest" />
    <None Update="sent.wav" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Stamp the executable with the git commit it was built from (InformationalVersion becomes "2.0.0+sha"
       and the commit date goes into an AssemblyMetadata attribute). The update check compares this with the
       latest build published on GitHub. Builds made outside a git checkout simply carry no commit. -->
  <Target Name="AowStampCommit" BeforeTargets="GetAssemblyVersion;GetAssemblyAttributes;GenerateAssemblyInfo" Condition="'$(SourceRevisionId)' == ''">
    <Exec Command="git rev-parse HEAD" WorkingDirectory="$(MSBuildProjectDirectory)" ConsoleToMSBuild="true" IgnoreExitCode="true" ContinueOnError="true" StandardOutputImportance="low" StandardErrorImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="AowGitCommit" />
      <Output TaskParameter="ExitCode" PropertyName="AowGitExitCode" />
    </Exec>
    <!-- %25%25 reaches the generated batch file as %%, which cmd.exe turns into the single % git needs -->
    <Exec Command="git log -1 --format=%25%25cI" WorkingDirectory="$(MSBuildProjectDirectory)" ConsoleToMSBuild="true" IgnoreExitCode="true" ContinueOnError="true" StandardOutputImportance="low" StandardErrorImportance="low" Condition="'$(AowGitExitCode)' == '0'">
      <Output TaskParameter="ConsoleOutput" PropertyName="AowGitCommitDate" />
    </Exec>
    <PropertyGroup Condition="'$(AowGitExitCode)' == '0' And '$(AowGitCommit)' != ''">
      <SourceRevisionId>$(AowGitCommit)</SourceRevisionId>
    </PropertyGroup>
    <ItemGroup Condition="'$(AowGitExitCode)' == '0' And '$(AowGitCommitDate)' != ''">
      <AssemblyMetadata Include="CommitDate" Value="$(AowGitCommitDate)" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

</Project>
